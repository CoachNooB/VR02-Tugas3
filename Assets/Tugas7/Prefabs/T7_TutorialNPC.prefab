  m_Name: 
  m_EditorClassIdentifier: Tugas7.Runtime::Tugas7.T7_TutorialNPC
  animator: {fileID: 7687074782868418608}
  dialogue: {fileID: 1832574997354617286}
  player: {fileID: 0}
  secondsPerLine: 4
  turnSpeed: 360
  dialogueLines:
  - Welcome to the Volcanic Training Facility. Reach the finish after activating
    all three checkpoints.
  - Lava and red machinery damage you. Blue checkpoint zones become respawn points
    and restore health.
  - Use WASD and the mouse to move, then press Space to jump over hazardous sections.
  - Press E near highlighted controls. Left-click the yellow crate to push it onto
    the pressure plate.
